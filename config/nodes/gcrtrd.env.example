# gcrtrd - Genesis Node Configuration
# "First node of the distributed HolDex network"

# ============================================
# NODE IDENTITY
# ============================================
NODE_ID=gcrtrd
NODE_NAME="Genesis Node"
NODE_OPERATOR=asdfasdfa
NODE_REGION=oregon

# Ed25519 private key for cryptographic signatures
# Generate with: node -e "console.log(require('./src/utils/nodeKeys').generateKeyPair())"
NODE_PRIVATE_KEY=your_base64_ed25519_private_key_here

# Public API URL (for other nodes to reach this one)
NODE_API_URL=https://gcrtrd.onrender.com

# ============================================
# CAPABILITIES
# ============================================
# What this node can do (comma-separated)
NODE_CAPABILITIES=polling,webhooks,verification,consensus

# Is this a seed node? (first node in network)
IS_SEED_NODE=true

# ============================================
# SHARED INFRASTRUCTURE
# ============================================
DATABASE_URL=postgresql://user:pass@host:5432/holdex
REDIS_URL=redis://user:pass@host:6379

# ============================================
# HELIUS (RPC + Webhooks)
# ============================================
HELIUS_API_KEY=your_helius_api_key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key

# Webhook configuration
USE_WEBHOOKS=true
WEBHOOK_AUTH_TOKEN=your_webhook_secret

# ============================================
# DISTRIBUTED POLLING TUNING
# ============================================
# Interval between poll attempts (ms) - default φ×1000
POLLING_INTERVAL_MS=1618

# Heartbeat interval (ms) - default φ×1000
HEARTBEAT_INTERVAL_MS=1618

# Max work credits per node (default φ²)
MAX_WORK_CREDITS=2.618

# Credit cost per poll (default φ⁻¹)
CREDIT_COST_POLL=0.618

# Credit regeneration rate per heartbeat (default φ⁻²)
CREDIT_REGEN_RATE=0.382

# ============================================
# SECURITY
# ============================================
DATA_SIGNING_SECRET=min_32_chars_secret_for_hmac_integrity
ADMIN_PASSWORD=your_admin_password

# ============================================
# OPTIONAL: RATE LIMITING
# ============================================
# Max RPC calls per minute (0 = unlimited)
MAX_RPC_CALLS_PER_MINUTE=60

# Max verifications per hour
MAX_VERIFICATIONS_PER_HOUR=1000
