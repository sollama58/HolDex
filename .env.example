# HolDex Environment Variables
# Copy to .env and fill in values

# Database (required)
DATABASE_URL=postgresql://user:password@host:5432/database

# Redis (required for workers)
REDIS_URL=redis://localhost:6379

# Solana/Helius (required)
HELIUS_API_KEY=your_helius_api_key

# Security (required - min 32 chars)
DATA_SIGNING_SECRET=your_32_char_min_signing_secret
ADMIN_PASSWORD=your_admin_password

# Distributed Nodes (optional)
NODE_ID=your_node_id
NODE_NAME=Your Node Name
NODE_PRIVATE_KEY=base64_encoded_ed25519_private_key
USE_DISTRIBUTED_POLLING=false

# API Keys (optional - comma-separated)
WHITELISTED_API_KEYS=key1,key2,key3
