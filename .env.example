# HolDex Environment Configuration
# Copy this file to .env and fill in your values

# Required
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional - Redis (defaults to localhost)
REDIS_URL=redis://localhost:6379

# Optional - Helius API for conviction analysis
HELIUS_API_KEY=

# Optional - Solana RPC (defaults to public mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional - Server port (defaults to 3000)
PORT=3000

# Optional - Admin password for protected endpoints
ADMIN_PASSWORD=

# Optional - Payment configuration
TREASURY_WALLET=
FEE_SOL=0.1
FEE_TOKEN_AMOUNT=5000
FEE_TOKEN_MINT=
